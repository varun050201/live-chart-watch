# Copy this to .env and fill in your own key. Never commit .env.
OPENAI_API_KEY=
# Optional: change the vision model (default gpt-4o-mini)
# VISION_MODEL=gpt-4o-mini
# Optional: point scoring at a different OpenAI-compatible endpoint
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# Optional: server host/port
# HOST=127.0.0.1
# PORT=3000
